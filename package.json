{
    "name": "mathtuto",
    "version": "1.2.0",
    "description": "MathTuto - An interactive educational adventure where students solve math and civic missions across five Philippine maps.",
    "author": "MathTuto Capstone Team",
    "license": "MIT",
    "keywords": [
        "phaser",
        "phaser3",
        "next",
        "nextjs",
        "math",
        "civics",
        "education",
        "game",
        "learning",
        "typescript",
        "capacitor"
    ],
    "scripts": {
        "dev": "node log.js dev & next dev -p 8080",
        "build": "node log.js build & next build",
        "dev-nolog": "next dev -p 8080",
        "build-nolog": "next build",
        "export": "next export",
        "build:capacitor": "next build && npx cap sync",
        "mobile:init": "npx cap init",
        "mobile:add:android": "npx cap add android",
        "mobile:sync": "npx cap sync",
        "mobile:open:android": "npx cap open android",
        "mobile:build:android": "npm run build:capacitor && cd android && gradlew assembleDebug",
        "mobile:build:android:release": "npm run build:capacitor && cd android && gradlew assembleRelease"
    },
    "dependencies": {
        "@capacitor/android": "^6.2.1",
        "@capacitor/app": "^6.0.3",
        "@capacitor/core": "^6.2.1",
        "@supabase/supabase-js": "^2.75.0",
        "lucide-react": "^0.545.0",
        "next": "15.3.1",
        "phaser": "^3.90.0",
        "react": "19.0.0",
        "react-dom": "19.0.0"
    },
    "devDependencies": {
        "@capacitor/cli": "^6.2.1",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "autoprefixer": "^10.0.1",
        "baseline-browser-mapping": "^2.11.20",
        "postcss": "^8",
        "tailwindcss": "^3.3.0",
        "typescript": "^5"
    }
}
